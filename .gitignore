*.gazebo_fix_backup

# Generated by aubo_description/xacro.sh from same-name .urdf files.
# Hand-written Xacro files under urdf/xacro/ remain tracked.
/src/aubo_ros2_driver/aubo_description/urdf/*.urdf.xacro

# Keep ROS package sources, hardware drivers, SDK build rules,
