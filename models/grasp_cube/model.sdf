<?xml version="1.0"?>
<sdf version="1.6">
  <model name="grasp_cube">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="cube_link">
      <gravity>true</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1.0416667e-5</ixx>
          <iyy>1.0416667e-5</iyy>
          <izz>1.0416667e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="cube_collision">
        <geometry>
          <box>
            <size>0.15 0.10 0.05</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Match the hopper bottom so ODE does not clamp the pair. -->
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="cube_visual">
        <geometry>
          <box>
            <size>0.15 0.10 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
