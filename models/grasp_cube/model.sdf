<?xml version="1.0"?>
<sdf version="1.6">
  <model name="grasp_cube">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="cube_link">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <!-- Preserve normal gravity fall speed. Angular damping suppresses
           residual rolling after the 0.81 m drop without slowing descent. -->
      <velocity_decay>
        <linear>0.0</linear>
        <angular>0.5</angular>
      </velocity_decay>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <!-- Solid-box inertia for 0.15 x 0.10 x 0.05 m at 0.05 kg. -->
          <ixx>5.2083333e-5</ixx>
          <iyy>1.0416667e-4</iyy>
          <izz>1.3541667e-4</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="cube_collision">
        <geometry>
          <box>
            <size>0.15 0.10 0.05</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Match the hopper bottom so ODE does not clamp the pair. -->
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Preserve rigid-contact stiffness while correcting small
                   time-step penetration promptly instead of visibly sinking. -->
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="cube_visual">
        <geometry>
          <box>
            <size>0.15 0.10 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
