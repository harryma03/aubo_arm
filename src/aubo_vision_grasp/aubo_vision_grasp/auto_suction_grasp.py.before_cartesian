#!/usr/bin/env python3

import math
import time
from collections import deque

import numpy as np
import rclpy

from rclpy.node import Node
from rclpy.action import ActionClient

from geometry_msgs.msg import PoseStamped, Pose
from moveit_msgs.action import MoveGroup
from moveit_msgs.msg import (
    Constraints,
    PositionConstraint,
    OrientationConstraint,
    BoundingVolume,
)
from shape_msgs.msg import SolidPrimitive
from std_srvs.srv import Trigger


class AutoSuctionGrasp(Node):

    def __init__(self):
        super().__init__('auto_suction_grasp')

        self.samples = deque(maxlen=15)

        self.create_subscription(
            PoseStamped,
            '/vision/target_pose',
            self.target_cb,
            10
        )

        self.move_client = ActionClient(
            self,
            MoveGroup,
            '/move_action'
        )

        self.suction_on = self.create_client(
            Trigger,
            '/suction_on'
        )

        self.get_logger().info(
            'Automatic suction grasp node started'
        )

    def target_cb(self, msg):
        if msg.header.frame_id != 'base_link':
            return

        p = msg.pose.position

        xyz = np.array([p.x, p.y, p.z], dtype=float)

        if np.all(np.isfinite(xyz)):
            self.samples.append(xyz)

    def get_target(self):

        self.get_logger().info(
            'Waiting for stable visual target...'
        )

        start = time.time()

        while rclpy.ok() and len(self.samples) < 10:

            rclpy.spin_once(
                self,
                timeout_sec=0.1
            )

            if time.time() - start > 10.0:
                raise RuntimeError(
                    'No stable /vision/target_pose received'
                )

        data = np.array(self.samples)

        target = np.median(data, axis=0)

        x, y, z = target

        self.get_logger().info(
            f'Visual target: '
            f'x={x:.3f}, y={y:.3f}, z={z:.3f}'
        )

        # 基本安全范围，防止识别异常时机器人乱跑
        if not (
            0.25 < x < 1.00 and
            -0.60 < y < 0.60 and
            0.65 < z < 1.10
        ):
            raise RuntimeError(
                f'Target outside safe workspace: '
                f'({x:.3f}, {y:.3f}, {z:.3f})'
            )

        return x, y, z

    def make_goal(self, x, y, z):

        goal = MoveGroup.Goal()

        req = goal.request

        req.group_name = 'manipulator'
        req.num_planning_attempts = 10
        req.allowed_planning_time = 5.0

        req.max_velocity_scaling_factor = 0.20
        req.max_acceleration_scaling_factor = 0.20

        req.start_state.is_diff = True

        c = Constraints()
        c.name = 'suction_tcp_goal'

        # --------------------------
        # Position constraint
        # --------------------------

        pc = PositionConstraint()

        pc.header.frame_id = 'base_link'
        pc.link_name = 'suction_tcp'
        pc.weight = 1.0

        bv = BoundingVolume()

        sphere = SolidPrimitive()
        sphere.type = SolidPrimitive.SPHERE

        # 5 mm position tolerance
        sphere.dimensions = [0.005]

        sphere_pose = Pose()
        sphere_pose.position.x = float(x)
        sphere_pose.position.y = float(y)
        sphere_pose.position.z = float(z)
        sphere_pose.orientation.w = 1.0

        bv.primitives.append(sphere)
        bv.primitive_poses.append(sphere_pose)

        pc.constraint_region = bv

        # --------------------------
        # Orientation constraint
        # suction_tcp +Z points down
        # RPY = (pi, 0, 0)
        # --------------------------

        oc = OrientationConstraint()

        oc.header.frame_id = 'base_link'
        oc.link_name = 'suction_tcp'

        oc.orientation.x = 1.0
        oc.orientation.y = 0.0
        oc.orientation.z = 0.0
        oc.orientation.w = 0.0

        # roll/pitch保持吸盘向下
        oc.absolute_x_axis_tolerance = 0.10
        oc.absolute_y_axis_tolerance = 0.10

        # 吸盘绕自身轴旋转无所谓
        oc.absolute_z_axis_tolerance = math.pi

        oc.weight = 1.0

        c.position_constraints.append(pc)
        c.orientation_constraints.append(oc)

        req.goal_constraints.append(c)

        goal.planning_options.plan_only = False
        goal.planning_options.look_around = False
        goal.planning_options.replan = False

        goal.planning_options.planning_scene_diff.is_diff = True
        goal.planning_options.planning_scene_diff.robot_state.is_diff = True

        return goal

    def move_to(self, name, x, y, z):

        self.get_logger().info(
            f'{name}: '
            f'({x:.3f}, {y:.3f}, {z:.3f})'
        )

        if not self.move_client.wait_for_server(
            timeout_sec=5.0
        ):
            raise RuntimeError(
                '/move_action is unavailable'
            )

        goal = self.make_goal(x, y, z)

        send_future = self.move_client.send_goal_async(goal)

        rclpy.spin_until_future_complete(
            self,
            send_future
        )

        handle = send_future.result()

        if handle is None or not handle.accepted:
            raise RuntimeError(
                f'{name}: MoveIt goal rejected'
            )

        result_future = handle.get_result_async()

        rclpy.spin_until_future_complete(
            self,
            result_future
        )

        wrapped = result_future.result()

        if wrapped is None:
            raise RuntimeError(
                f'{name}: no MoveIt result'
            )

        result = wrapped.result

        if result.error_code.val != 1:
            raise RuntimeError(
                f'{name}: MoveIt failed, '
                f'error_code={result.error_code.val}'
            )

        self.get_logger().info(
            f'{name}: SUCCESS'
        )

    def enable_suction(self):

        self.get_logger().info(
            'Calling /suction_on...'
        )

        if not self.suction_on.wait_for_service(
            timeout_sec=5.0
        ):
            raise RuntimeError(
                '/suction_on service unavailable'
            )

        req = Trigger.Request()

        future = self.suction_on.call_async(req)

        rclpy.spin_until_future_complete(
            self,
            future
        )

        response = future.result()

        if response is None:
            raise RuntimeError(
                'No /suction_on response'
            )

        self.get_logger().info(
            f'/suction_on: '
            f'success={response.success}, '
            f'message="{response.message}"'
        )

        if not response.success:
            raise RuntimeError(
                'Suction attach failed: '
                + response.message
            )

    def run(self):

        x, y, z = self.get_target()

        # 1. 方块上方 15 cm
        pre_z = z + 0.15

        # 2. 方块顶面上方约 2 cm
        contact_z = z + 0.02

        # 3. 吸住以后提升约 22 cm
        lift_z = z + 0.30

        self.get_logger().info(
            'STEP 1/4: moving to pre-grasp'
        )

        self.move_to(
            'PRE_GRASP',
            x,
            y,
            pre_z
        )

        time.sleep(0.5)

        self.get_logger().info(
            'STEP 2/4: descending'
        )

        self.move_to(
            'SUCTION',
            x,
            y,
            contact_z
        )

        time.sleep(0.5)

        self.get_logger().info(
            'STEP 3/4: suction ON'
        )

        self.enable_suction()

        time.sleep(0.5)

        self.get_logger().info(
            'STEP 4/4: lifting object'
        )

        self.move_to(
            'LIFT',
            x,
            y,
            lift_z
        )

        self.get_logger().info(
            'AUTO GRASP COMPLETED'
        )


def main(args=None):

    rclpy.init(args=args)

    node = AutoSuctionGrasp()

    try:
        node.run()

    except Exception as e:
        node.get_logger().error(
            f'AUTO GRASP FAILED: {e}'
        )

    finally:
        node.destroy_node()

        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
