<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="aubo_ros2_control" params="name prefix robot_model use_fake_hardware:=false robot_ip sim_gazebo:=false">
    <!-- JAKA Zu12 startup pose: (-90, 90, 0, 180, 90, 90) degrees. -->
    <xacro:property name="home_shoulder" value="-1.5707963267948966"/>
    <xacro:property name="home_upper_arm" value="1.5707963267948966"/>
    <xacro:property name="home_forearm" value="0.0"/>
    <xacro:property name="home_wrist1" value="3.141592653589793"/>
    <xacro:property name="home_wrist2" value="1.5707963267948966"/>
    <xacro:property name="home_wrist3" value="1.5707963267948966"/>
    <xacro:property name="shoulder_min" value="-3.141592653589793"/>
    <xacro:property name="shoulder_max" value="3.141592653589793"/>
    <xacro:property name="upper_arm_min" value="-3.141592653589793"/>
    <xacro:property name="upper_arm_max" value="3.141592653589793"/>
    <xacro:property name="forearm_min" value="-3.141592653589793"/>
    <xacro:property name="forearm_max" value="3.141592653589793"/>
    <xacro:property name="wrist1_min" value="-3.141592653589793"/>
    <xacro:property name="wrist1_max" value="3.141592653589793"/>
    <xacro:property name="wrist2_min" value="-3.141592653589793"/>
    <xacro:property name="wrist2_max" value="3.141592653589793"/>
    <xacro:property name="wrist3_min" value="-3.141592653589793"/>
    <xacro:property name="wrist3_max" value="3.141592653589793"/>
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
      <joint name="shoulder_joint">
        <command_interface name="position">
          <param name="min">${shoulder_min}</param>
          <param name="max">${shoulder_max}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${home_shoulder}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="upperArm_joint">
        <command_interface name="position">
          <param name="min">${upper_arm_min}</param>
          <param name="max">${upper_arm_max}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${home_upper_arm}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="foreArm_joint">
        <command_interface name="position">
          <param name="min">${forearm_min}</param>
          <param name="max">${forearm_max}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${home_forearm}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wrist1_joint">
        <command_interface name="position">
          <param name="min">${wrist1_min}</param>
          <param name="max">${wrist1_max}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${home_wrist1}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wrist2_joint">
        <command_interface name="position">
          <param name="min">${wrist2_min}</param>
          <param name="max">${wrist2_max}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${home_wrist2}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wrist3_joint">
        <command_interface name="position">
          <param name="min">${wrist3_min}</param>
          <param name="max">${wrist3_max}</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">${home_wrist3}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
