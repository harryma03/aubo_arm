<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="jaka_Zu12">
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="robot_ip" default="None"/>
    <xacro:property name="robot_ip" value="$(arg robot_ip)"/>
  <xacro:arg name="aubo_type" default="None"/>
    <xacro:property name="aubo_type" value="$(arg aubo_type)"/>
  <xacro:arg name="use_fake_hardware" default="true"/>
    <xacro:property name="use_fake_hardware" value="$(arg use_fake_hardware)"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="robot_x" default="0.0"/>
  <xacro:arg name="robot_y" default="0.0"/>
    <xacro:property name="robot_x" value="$(arg robot_x)"/>
    <xacro:property name="robot_y" value="$(arg robot_y)"/>
    <xacro:property name="sim_gazebo" value="$(arg sim_gazebo)"/>
  <xacro:include filename="$(find aubo_description)/urdf/xacro/inc/aubo_ros2_macro.xacro"/>
  <xacro:aubo_robot 
    transmission_hw_interface="$(arg transmission_hw_interface)" 
    aubo_type="${aubo_type}"/>

  <!-- Gazebo needs an explicit world joint; otherwise the complete robot
       model is a free rigid body and falls into the workcell. robot_x/y keep
       the Gazebo, robot_state_publisher and MoveIt base frames identical. -->
  <xacro:if value="${sim_gazebo}">
    <link name="world"/>
    <joint name="world_fixed_joint" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="${robot_x} ${robot_y} 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- ros2_control -->
  <xacro:include filename="$(find aubo_description)/urdf/xacro/inc/aubo.ros2_control.xacro" />
  <xacro:aubo_ros2_control
    name="auboHardwareInterface"
    prefix=""
    robot_model="${aubo_type}"
    use_fake_hardware="${use_fake_hardware}"
    robot_ip="${robot_ip}"
    sim_gazebo="${sim_gazebo}"/>

  <!-- Gazebo Classic ros2_control -->

  <!-- Gazebo Classic + ros2_control -->
  <gazebo>
    <!-- Hold the physical Gazebo joints at the configured home pose while
         ros2_control starts. The launch file hands the identical target to the
         trajectory controller before this short startup hold is released. -->
    <plugin name="jaka_initial_pose"
            filename="libjaka_initial_pose_plugin.so"/>
    <plugin name="gazebo_ros2_control"
            filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find aubo_gazebo)/config/aubo_controllers.yaml</parameters>
    </plugin>
  </gazebo>



  <!-- ================= AUBO suction cup ================= -->

  <link name="suction_cup_link">

    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="suction_body">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00010"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00010"
        iyz="0.0"
        izz="0.00005"/>
    </inertial>

  </link>

  <joint name="suction_cup_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="suction_cup_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- Rubber suction disk -->

  <link name="suction_pad_link">

    <visual>
      <origin xyz="0 0 0.0875" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.015"/>
      </geometry>
      <material name="suction_pad">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.0875" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.015"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.0875" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00003"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00003"
        iyz="0.0"
        izz="0.00002"/>
    </inertial>

  </link>

  <joint name="suction_pad_joint" type="fixed">
    <parent link="suction_cup_link"/>
    <child link="suction_pad_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <!-- TCP center of suction surface -->

  <link name="suction_tcp">
    <!-- A tiny valid inertia prevents Gazebo's URDF->SDF conversion from
         deleting this fixed child link before the suction plugin resolves it. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.0001"/>
      <inertia
        ixx="0.00000001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00000001"
        iyz="0.0"
        izz="0.00000001"/>
    </inertial>
  </link>

  <joint name="suction_tcp_joint" type="fixed">
    <parent link="suction_cup_link"/>
    <child link="suction_tcp"/>
    <origin xyz="0 0 0.095" rpy="0 0 0"/>
  </joint>

  <!-- =================================================== -->



  

  <!-- Let Gazebo lump the complete fixed tool chain into wrist3_Link. This
       keeps RViz link frames while avoiding a redundant chain of dynamic
       fixed constraints that visibly oscillates in Gazebo. The suction
       plugin reconstructs the TCP from the rigid wrist transform. -->

<gazebo>
    <plugin
      name="suction_attach_plugin"
      filename="libsuction_attach_plugin.so"/>
  </gazebo>

</robot>
