# Robot workcell and grasp system -- single user configuration source.
# Values are metres unless otherwise stated. Workspace commands load and
# export this file through scripts/lib/env.sh.
# Do not duplicate these defaults in launcher scripts.

# Robot-model interface -------------------------------------------------
# This is the only selector that normal users need to change.  Every model
# used by this workcell must expose the canonical links/joints documented
# below; brand-specific URDF names are adapted inside aubo_description.
ROBOT_MODEL="${ROBOT_MODEL:-${AUBO_MOVEIT_MODEL:-aubo_i10}}"
ROBOT_BASE_LINK="${ROBOT_BASE_LINK:-base_link}"
ROBOT_FLANGE_LINK="${ROBOT_FLANGE_LINK:-wrist3_Link}"
ROBOT_TCP_LINK="${ROBOT_TCP_LINK:-suction_tcp}"
ROBOT_PLANNING_GROUP="${ROBOT_PLANNING_GROUP:-manipulator}"
ROBOT_JOINT_NAMES="${ROBOT_JOINT_NAMES:-shoulder_joint,upperArm_joint,foreArm_joint,wrist1_joint,wrist2_joint,wrist3_joint}"
# Compatibility alias for existing launch files. New callers should set
# ROBOT_MODEL instead of AUBO_MOVEIT_MODEL.
AUBO_MOVEIT_MODEL="$ROBOT_MODEL"
#
# The robot base_link remains at world (0, 0, 0). Change these values when
# moving the complete workcell relative to the robot.
AUBO_WORKCELL_X="${AUBO_WORKCELL_X:-0.0}"
AUBO_WORKCELL_Y="${AUBO_WORKCELL_Y:-0.0}"
AUBO_WORKCELL_Z="${AUBO_WORKCELL_Z:--0.95}"

# Hopper link pose inside workcell_environment/model.sdf.
# Keep these values identical to the <link name="box"><pose> entry.
# The current SDF uses y=-0.75005309.
AUBO_HOPPER_LOCAL_X="${AUBO_HOPPER_LOCAL_X:-0.00000335}"
AUBO_HOPPER_LOCAL_Y="${AUBO_HOPPER_LOCAL_Y:--0.75005309}"
AUBO_HOPPER_LOCAL_Z="${AUBO_HOPPER_LOCAL_Z:-0.93443794}"

# Geometry used to derive the object-center safety region. These values must
# match the current SDF bottom and models/grasp_cube/model.sdf dimensions.
AUBO_HOPPER_BOTTOM_SIZE_X="${AUBO_HOPPER_BOTTOM_SIZE_X:-0.615}"
AUBO_HOPPER_BOTTOM_SIZE_Y="${AUBO_HOPPER_BOTTOM_SIZE_Y:-0.930}"
AUBO_CUBE_SIZE_X="${AUBO_CUBE_SIZE_X:-0.150}"
AUBO_CUBE_SIZE_Y="${AUBO_CUBE_SIZE_Y:-0.100}"
AUBO_CUBE_SIZE_Z="${AUBO_CUBE_SIZE_Z:-0.050}"
# Keep a real wall clearance while allowing targets close to the measured
# hopper edge.  Five millimetres is the experimental minimum; do not make it
# negative to force an otherwise colliding target into planning.
AUBO_HOPPER_WALL_MARGIN="${AUBO_HOPPER_WALL_MARGIN:-0.005}"
# Cube spawn centre height above the default world reference.  4 cm keeps the
# cube clear of the hopper rim while greatly reducing bounce after spawning.
AUBO_CUBE_DROP_HEIGHT="${AUBO_CUBE_DROP_HEIGHT:-0.040}"

# Dynamic visual-picking configuration.
# These values are deliberately independent of the number of spawned objects.
# They control scene association and the optional RGB-D separation step.
# Random-scene generator count.  Detection and queue completion remain
# dynamic; this value controls only how many Gazebo entities are generated.
AUBO_RANDOM_CUBE_COUNT="${AUBO_RANDOM_CUBE_COUNT:-6}"
# New cubes get this short physics-only period before the detector is started.
AUBO_INITIAL_SCENE_SETTLE_TIME="${AUBO_INITIAL_SCENE_SETTLE_TIME:-2.00}"
# A scene is accepted after this duration of small (< stability distance) motion.
AUBO_TARGET_STABLE_TIME="${AUBO_TARGET_STABLE_TIME:-0.80}"
AUBO_TARGET_EMPTY_STABLE_TIME="${AUBO_TARGET_EMPTY_STABLE_TIME:-2.00}"
AUBO_TARGET_MESSAGE_TIMEOUT="${AUBO_TARGET_MESSAGE_TIMEOUT:-4.00}"
AUBO_TARGET_STABILITY_DISTANCE="${AUBO_TARGET_STABILITY_DISTANCE:-0.020}"
# Require both a stable duration and this many consecutive detector frames.
AUBO_TARGET_STABLE_FRAMES="${AUBO_TARGET_STABLE_FRAMES:-8}"
AUBO_TARGET_MATCH_DISTANCE="${AUBO_TARGET_MATCH_DISTANCE:-0.120}"
AUBO_TARGET_MISSING_CONFIRMATIONS="${AUBO_TARGET_MISSING_CONFIRMATIONS:-3}"
AUBO_TARGET_MAX_RETRIES="${AUBO_TARGET_MAX_RETRIES:-1}"
AUBO_TARGET_EDGE_MARGIN="${AUBO_TARGET_EDGE_MARGIN:-0.080}"
# One retry switches an edge target to the staged hopper-centre approach.
AUBO_TARGET_EDGE_MAX_RETRIES="${AUBO_TARGET_EDGE_MAX_RETRIES:-1}"
# For targets close to a hopper wall, move the TCP slightly toward the hopper
# centre while retaining the detected object centre for queue association and
# payload collision geometry.  The 10 mm offset is intentionally biased toward
# successful corner picks; payload offset is retained for collision checking.
AUBO_EDGE_GRASP_COMPENSATION="${AUBO_EDGE_GRASP_COMPENSATION:-1}"
AUBO_EDGE_GRASP_TRIGGER="${AUBO_EDGE_GRASP_TRIGGER:-0.080}"
AUBO_EDGE_GRASP_OFFSET="${AUBO_EDGE_GRASP_OFFSET:-0.010}"
AUBO_TARGET_SNAPSHOT_TIMEOUT="${AUBO_TARGET_SNAPSHOT_TIMEOUT:-8.0}"
AUBO_TARGET_SETTLE_TIME="${AUBO_TARGET_SETTLE_TIME:-0.8}"
AUBO_RECOVERY_TIMEOUT="${AUBO_RECOVERY_TIMEOUT:-12.0}"
AUBO_OMPL_PLANNING_TIME="${AUBO_OMPL_PLANNING_TIME:-6.0}"
AUBO_OMPL_PLANNING_ATTEMPTS="${AUBO_OMPL_PLANNING_ATTEMPTS:-4}"
AUBO_RECOVERY_JOINT_TOLERANCE="${AUBO_RECOVERY_JOINT_TOLERANCE:-0.12}"
AUBO_READY_JOINT_TOLERANCE="${AUBO_READY_JOINT_TOLERANCE:-0.025}"
# Fixed READY pose, ordered as shoulder, upperArm, foreArm, wrist1, wrist2,
# wrist3 (radians).
AUBO_READY_JOINTS="${AUBO_READY_JOINTS:--1.535890,-0.401426,2.024582,0.855211,1.500983,0.000000}"
AUBO_TARGET_SPLIT_ENABLE="${AUBO_TARGET_SPLIT_ENABLE:-1}"
AUBO_TARGET_SPLIT_PEAK_RATIO="${AUBO_TARGET_SPLIT_PEAK_RATIO:-0.42}"
AUBO_TARGET_SPLIT_MIN_AREA_RATIO="${AUBO_TARGET_SPLIT_MIN_AREA_RATIO:-1.40}"
# A merged contour is pickable only when its inferred object count and all
# split pieces agree with the projected physical cube area.
AUBO_TARGET_SPLIT_COUNT_TOLERANCE="${AUBO_TARGET_SPLIT_COUNT_TOLERANCE:-0.20}"
AUBO_TARGET_SPLIT_CANDIDATE_MIN_RATIO="${AUBO_TARGET_SPLIT_CANDIDATE_MIN_RATIO:-0.45}"
AUBO_TARGET_SPLIT_CANDIDATE_MAX_RATIO="${AUBO_TARGET_SPLIT_CANDIDATE_MAX_RATIO:-1.35}"
AUBO_VISION_PROCESSING_RATE="${AUBO_VISION_PROCESSING_RATE:-5.0}"
AUBO_RGBD_SYNC_SLOP="${AUBO_RGBD_SYNC_SLOP:-0.100}"
AUBO_TARGET_MIN_Z="${AUBO_TARGET_MIN_Z:--0.82}"
AUBO_TARGET_MAX_Z="${AUBO_TARGET_MAX_Z:--0.55}"
AUBO_TARGET_MAX_DEPTH_SPREAD="${AUBO_TARGET_MAX_DEPTH_SPREAD:-0.060}"
AUBO_TARGET_MIN_AREA_RATIO="${AUBO_TARGET_MIN_AREA_RATIO:-0.25}"
AUBO_TARGET_MAX_AREA_RATIO="${AUBO_TARGET_MAX_AREA_RATIO:-1.85}"
# Show the detector overlay when a graphical DISPLAY is available. The
# detector always publishes /vision/debug_image for RViz/rqt inspection.
AUBO_VISION_DISPLAY="${AUBO_VISION_DISPLAY:-1}"
# RGB-D positions already fluctuate by a few millimetres.  Three millimetres
# avoids inflated neighbouring boxes blocking a valid grasp while preserving
# a non-zero collision allowance around every non-selected cube.
AUBO_TARGET_COLLISION_PADDING="${AUBO_TARGET_COLLISION_PADDING:-0.003}"
# Unresolved merged contours are kept as enlarged MoveIt obstacles.
AUBO_AMBIGUOUS_OBSTACLE_SCALE="${AUBO_AMBIGUOUS_OBSTACLE_SCALE:-2.50}"

# RGB-D ROS interfaces. Override these only if the Gazebo camera remappings
# are changed; startup checks and the detector consume the same values.
AUBO_RGB_TOPIC="${AUBO_RGB_TOPIC:-/camera/workcell_camera/image_raw}"
AUBO_DEPTH_TOPIC="${AUBO_DEPTH_TOPIC:-/camera/workcell_camera/depth/image_raw}"
AUBO_CAMERA_INFO_TOPIC="${AUBO_CAMERA_INFO_TOPIC:-/camera/workcell_camera/depth/camera_info}"

# The ground normally moves with the workcell, but remains overridable.
AUBO_GROUND_X="${AUBO_GROUND_X:-$AUBO_WORKCELL_X}"
AUBO_GROUND_Y="${AUBO_GROUND_Y:-$AUBO_WORKCELL_Y}"
AUBO_GROUND_Z="${AUBO_GROUND_Z:-$AUBO_WORKCELL_Z}"

# RGB-D camera mount pose in the workcell model frame.
AUBO_CAMERA_LOCAL_X="${AUBO_CAMERA_LOCAL_X:-0.126}"
AUBO_CAMERA_LOCAL_Y="${AUBO_CAMERA_LOCAL_Y:--0.914}"
AUBO_CAMERA_LOCAL_Z="${AUBO_CAMERA_LOCAL_Z:-1.740}"
