<?xml version="1.0"?>
<sdf version="1.6">
  <model name="workcell_environment">
    <static>true</static>

    <!-- Original coordinates from robot.urdf. The launch file spawns this
         complete workcell at z=-0.95, so the original Joint_1 mount
         (z=+0.95 relative to base_link) coincides with the EXISTING AUBO
         base_link at world z=0. This keeps the current AUBO/MoveIt/TF setup
         unchanged. -->

    <link name="workcell_base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry><mesh><uri>model://workcell_environment/meshes/base_link.stl</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>model://workcell_environment/meshes/base_link.stl</uri></mesh></geometry>
      </collision>
    </link>


    <link name="box">

      <!--
        Keep the original top rim position unchanged.

        Outer height = 0.12 m
        Bottom thickness = 0.02 m
        Effective inner depth = 0.10 m
      -->
      <pose>0.39500125 -0.32996664 0.81443794 0 0.00000367 -1.57079265</pose>

      <!-- Keep original appearance, only make it shallow in Z -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://workcell_environment/meshes/box.stl</uri>
            <scale>1 1 0.12843</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- bottom -->

      <!-- x-min wall -->

      <!-- x-max wall -->

      <!-- y-min wall -->

      <!-- y-max wall -->

    
      <collision name="table_surface_collision">
        <pose>0.570085 -0.395 0.070 0 0 0</pose>
        <geometry>
          <box>
            <size>1.14017 0.79000 0.100</size>
          </box>
        </geometry>
      </collision>
</link>


    <link name="store">
      <pose>-0.42499759 -0.64593152 0.01004677 0 0.00000367 -1.57079265</pose>
      <visual name="visual">
        <geometry><mesh><uri>model://workcell_environment/meshes/store.stl</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>model://workcell_environment/meshes/store.stl</uri></mesh></geometry>
      </collision>
    </link>

    <link name="camera_holder">
      <pose>0.59012976 -0.92535016 0.01004575 0 -0.00000367 1.5708</pose>
      <visual name="visual">
        <geometry><mesh><uri>model://workcell_environment/meshes/camera_holder.stl</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>model://workcell_environment/meshes/camera_holder.stl</uri></mesh></geometry>
      </collision>
    </link>
  
    <!-- AUBO_WORKCELL_RGBD_CAMERA_BEGIN -->

    <!--
      Fixed Eye-to-Hand RGB-D camera.

      Workcell is spawned at world z = -0.95 m.

      Therefore local pose:
          z = 1.815
      corresponds to:
          world/base_link z ~= 0.865 m

      Camera native +X axis is pitched downward.
    -->

    <link name="rgbd_camera_mount">

      <pose>
        0.026 -0.914 1.815
        0 1.5707963 0
      </pose>

      <!-- Visible camera body -->
      <visual name="camera_body_visual">

        <pose>-0.035 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>0.070 0.100 0.045</size>
          </box>
        </geometry>

        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>

      </visual>

      <!-- RGB-D sensor -->
      <sensor name="workcell_rgbd" type="depth">

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>

        <camera>

          <!-- about 86 degrees -->
          <horizontal_fov>1.50</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.10</near>
            <far>3.00</far>
          </clip>

          <depth_camera>
            <output>depths</output>
          </depth_camera>

        </camera>

        <plugin
          name="workcell_rgbd_plugin"
          filename="libgazebo_ros_camera.so">

          <ros>
            <namespace>/camera</namespace>

            <remapping>
              image_raw:=color/image_raw
            </remapping>

            <remapping>
              camera_info:=color/camera_info
            </remapping>

            <remapping>
              depth/image_raw:=rgbd/depth/image_raw
            </remapping>

            <remapping>
              depth/camera_info:=rgbd/depth/camera_info
            </remapping>

            <remapping>
              points:=depth/points
            </remapping>

          </ros>

          <camera_name>workcell_camera</camera_name>

          <!-- ROS optical frame -->
          <frame_name>camera_link</frame_name>

          <min_depth>0.10</min_depth>
          <max_depth>3.00</max_depth>

        </plugin>

      </sensor>

    </link>

    <!-- AUBO_WORKCELL_RGBD_CAMERA_END -->

  </model>
</sdf>
