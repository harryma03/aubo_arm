<?xml version="1.0"?>
<sdf version="1.6">
  <model name="workcell_environment">
    <static>true</static>

    <!-- This separate workcell model retains its original CAD coordinates.
         Spawning it at z=-0.95 aligns its arm mounting point with the JAKA
         base_link at world z=0. The current arm-only URDF does not define
         this workcell geometry. -->

    <link name="workcell_base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="visual">
        <geometry><mesh><uri>model://workcell_environment/meshes/base_link.stl</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>model://workcell_environment/meshes/base_link.stl</uri></mesh></geometry>
      </collision>
    </link>


    <!-- ========================================================= -->
    <!-- SOURCE HOPPER                                             -->
    <!-- Top inner opening : 0.740 x 1.095 m                      -->
    <!-- Bottom inner size : 0.615 x 0.930 m                      -->
    <!-- Inner depth       : 0.810 m                              -->
    <!-- Interior is hollow                                      -->
    <!-- ========================================================= -->

    <link name="box">

      <!--
        Keep the original source-table top-center position.

        This model is spawned at world z = -0.95.

        Model coordinates here:
          x =  0.000003
          y = -0.750053
          z =  0.934438

        Therefore hopper top opening in world:
          x ~=  0.000
          y ~= -0.750
          z ~= -0.01556
      -->
      <pose>0.00000335 -0.75005309 0.93443794 0 0 0</pose>


      <!-- ===================================================== -->
      <!-- RIGHT WALL : +X                                      -->
      <!-- top x = +0.370                                       -->
      <!-- bottom x = +0.3075                                   -->
      <!-- ===================================================== -->

      <collision name="hopper_right_collision">
        <pose>0.33875 0 -0.405 0 0.0770079 0</pose>
        <geometry>
          <box>
            <size>0.020 1.095 0.812408</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Keep rigid stiffness; allow prompt penetration correction. -->
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="hopper_right_visual">
        <pose>0.33875 0 -0.405 0 0.0770079 0</pose>
        <geometry>
          <box>
            <size>0.020 1.095 0.812408</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>


      <!-- ===================================================== -->
      <!-- LEFT WALL : -X                                       -->
      <!-- ===================================================== -->

      <collision name="hopper_left_collision">
        <pose>-0.33875 0 -0.405 0 -0.0770079 0</pose>
        <geometry>
          <box>
            <size>0.020 1.095 0.812408</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Keep rigid stiffness; allow prompt penetration correction. -->
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="hopper_left_visual">
        <pose>-0.33875 0 -0.405 0 -0.0770079 0</pose>
        <geometry>
          <box>
            <size>0.020 1.095 0.812408</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>


      <!-- ===================================================== -->
      <!-- FRONT WALL : -Y                                      -->
      <!-- top y = -0.5475                                     -->
      <!-- bottom y = -0.465                                   -->
      <!-- ===================================================== -->

      <collision name="hopper_front_collision">
        <pose>0 -0.50625 -0.405 0.1015018 0 0</pose>
        <geometry>
          <box>
            <size>0.740 0.020 0.814191</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Keep rigid stiffness; allow prompt penetration correction. -->
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="hopper_front_visual">
        <pose>0 -0.50625 -0.405 0.1015018 0 0</pose>
        <geometry>
          <box>
            <size>0.740 0.020 0.814191</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>


      <!-- ===================================================== -->
      <!-- BACK WALL : +Y                                       -->
      <!-- ===================================================== -->

      <collision name="hopper_back_collision">
        <pose>0 0.50625 -0.405 -0.1015018 0 0</pose>
        <geometry>
          <box>
            <size>0.740 0.020 0.814191</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Keep rigid stiffness; allow prompt penetration correction. -->
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="hopper_back_visual">
        <pose>0 0.50625 -0.405 -0.1015018 0 0</pose>
        <geometry>
          <box>
            <size>0.740 0.020 0.814191</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>


      <!-- ===================================================== -->
      <!-- BOTTOM                                                -->
      <!-- inner bottom surface z = -0.810                      -->
      <!-- ===================================================== -->

      <collision name="hopper_bottom_collision">
        <pose>0 0 -0.825 0 0 0</pose>
        <geometry>
          <box>
            <size>0.615 0.930 0.030</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- High static/dynamic friction for settled source objects. -->
              <mu>1.2</mu>
              <mu2>1.2</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Keep rigid stiffness; allow prompt penetration correction. -->
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="hopper_bottom_visual">
        <pose>0 0 -0.825 0 0 0</pose>
        <geometry>
          <box>
            <size>0.615 0.930 0.030</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.82 0.82 1</ambient>
          <diffuse>0.82 0.82 0.82 1</diffuse>
        </material>
      </visual>

    </link>


    <link name="store">
      <pose>-0.42499759 -0.64593152 0.01004677 0 0.00000367 -1.57079265</pose>
      <visual name="visual">
        <geometry><mesh><uri>model://workcell_environment/meshes/store.stl</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>model://workcell_environment/meshes/store.stl</uri></mesh></geometry>
      </collision>
    </link>

    <link name="camera_holder">
      <pose>0.69012976 -0.92535016 0.01004575 0 -0.00000367 1.5708</pose>
      <visual name="visual">
        <geometry><mesh><uri>model://workcell_environment/meshes/camera_holder.stl</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <geometry><mesh><uri>model://workcell_environment/meshes/camera_holder.stl</uri></mesh></geometry>
      </collision>
    </link>
  
    <!-- AUBO_WORKCELL_RGBD_CAMERA_BEGIN -->

    <!--
      Fixed Eye-to-Hand RGB-D camera.

      Workcell is spawned at world z = -0.95 m.

      Therefore local pose:
          z = 1.815
      corresponds to:
          world/base_link z ~= 0.865 m

      Camera native +X axis is pitched downward.
    -->

    <link name="rgbd_camera_mount">

      <pose>
        0.126 -0.914 1.740
        0 1.5707963 0
      </pose>

      <!-- Visible camera body -->
      <visual name="camera_body_visual">

        <pose>-0.035 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>0.070 0.100 0.045</size>
          </box>
        </geometry>

        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.18 0.18 0.18 1</diffuse>
        </material>

      </visual>

      <!-- RGB-D sensor -->
      <sensor name="workcell_rgbd" type="depth">

        <always_on>true</always_on>
        <!-- Vision consumes at 5 Hz; 15 Hz preserves responsiveness while
             halving raw RGB-D DDS bandwidth. -->
        <update_rate>15</update_rate>
        <visualize>true</visualize>

        <camera>

          <!-- about 86 degrees -->
          <horizontal_fov>1.50</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.10</near>
            <far>3.00</far>
          </clip>

          <depth_camera>
            <output>depths</output>
          </depth_camera>

        </camera>

        <plugin
          name="workcell_rgbd_plugin"
          filename="libgazebo_ros_camera.so">

          <ros>
            <namespace>/camera</namespace>

            <remapping>
              image_raw:=color/image_raw
            </remapping>

            <remapping>
              camera_info:=color/camera_info
            </remapping>

            <remapping>
              depth/image_raw:=rgbd/depth/image_raw
            </remapping>

            <remapping>
              depth/camera_info:=rgbd/depth/camera_info
            </remapping>

            <remapping>
              points:=depth/points
            </remapping>

          </ros>

          <camera_name>workcell_camera</camera_name>

          <!-- ROS optical frame -->
          <frame_name>camera_link</frame_name>

          <min_depth>0.10</min_depth>
          <max_depth>3.00</max_depth>

        </plugin>

      </sensor>

    </link>

    <!-- AUBO_WORKCELL_RGBD_CAMERA_END -->

  </model>
</sdf>
